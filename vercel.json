{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/chat(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/auth/(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/activities(.*)",
      "dest": "src/main.ts"
    },
    {
      "src": "/progress(.*)",
      "dest": "src/main.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
